# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT — generate a strong random secret (e.g. node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_this_with_a_strong_random_secret
